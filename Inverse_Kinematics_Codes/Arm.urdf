<?xml version="1.0"?>
<robot name="Robotic_Arm_6dof">
  <link name="base_link"/>
  
  <link name="link1"/>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 68" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.309" upper="1.309" effort="10" velocity="1"/>
  </joint>

  <link name="link2"/>
  <joint name="joint2" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.222" upper="1.222" effort="10" velocity="1"/>
  </joint>

  <link name="link3"/>
  <joint name="joint3" type="revolute">
    <parent link="link2"/><child link="link3"/>
    <origin xyz="0 0 165" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.309" upper="1.309" effort="10" velocity="1"/>
  </joint>

  <link name="link4"/>
  <joint name="joint4" type="revolute">
    <parent link="link3"/><child link="link4"/>
    <origin xyz="0 0 109" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.222" upper="1.222" effort="10" velocity="1"/>
  </joint>

  <link name="link5"/>
  <joint name="joint5" type="revolute">
    <parent link="link4"/><child link="link5"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.222" upper="1.222" effort="10" velocity="1"/>
  </joint>

  <link name="end_effector"/>
  <joint name="joint6" type="revolute">
    <parent link="link5"/><child link="end_effector"/>
    <origin xyz="0 0 150" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.309" upper="1.309" effort="10" velocity="1"/>
  </joint>
</robot>